// Veridian Planner Phase 1 data model (spec section 21).
// Postgres via Prisma. Phase 2 (Xero connection, e-signature, Graph write,
// settlement, passkeys, client portal) is not built, but this model leaves
// room for it: entities own clients/templates/currency and are never
// combined; settings are effective-dated and never overwritten; sent
// statements and exported billing lines are locked.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- People and access ----------

enum Role {
  ADMIN
  PARTNER
}

model User {
  id              String   @id @default(cuid())
  email           String   @unique
  name            String
  role            Role     @default(PARTNER)
  passwordHash    String? // Argon2id; null until the invite is accepted
  invitedById     String?
  invitedBy       User?    @relation("UserInvites", fields: [invitedById], references: [id])
  invites         User[]   @relation("UserInvites")
  invitedAt       DateTime?
  activatedAt     DateTime?
  disabledAt      DateTime?
  // Partner visibility: others see free/busy only (default on; spec 2).
  shareFreeBusy   Boolean  @default(true)
  createdAt       DateTime @default(now())

  sessions        Session[]
  trustedDevices  TrustedDevice[]
  loginEvents     LoginEvent[]
  oneTimeCodes    OneTimeCode[]
  magicLinks      MagicLink[]
  settings        SettingsHistory[]
  entityShares    EntityShare[]
  clientShares    ClientShare[]
  bookings        Booking[]
  calendarSources CalendarSource[]
  expenses        Expense[]
  mileageEntries  MileageLedger[]
  scenarios       Scenario[]
  alerts          Alert[]
  auditEntries    AuditLog[]
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique // only the hash is stored
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime // max 30 days; idle timeout 12h enforced in code
  ip         String?
  userAgent  String?
  revokedAt  DateTime?
}

model TrustedDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  label      String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime // 30 days
  revokedAt  DateTime?
}

model LoginEvent {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email     String // as entered, for uniform-response rate limiting
  kind      String // password_ok, password_fail, code_ok, code_fail, magic_ok, locked, new_device
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([email, createdAt])
}

model OneTimeCode {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash  String // 6 digits, hashed
  purpose   String // login, reset
  attempts  Int      @default(0) // max 5
  createdAt DateTime @default(now())
  expiresAt DateTime // 10 minutes
  usedAt    DateTime?
}

model MagicLink {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  browserNonce String // must match the requesting browser; else show a code
  createdAt   DateTime @default(now())
  expiresAt   DateTime // 15 minutes, single use
  usedAt      DateTime?
}

// ---------- Settings (effective-dated, never overwritten) ----------

model SettingsHistory {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  effectiveFrom DateTime @db.Date
  // Rates in the user's entity currency; contracts keep their signed rate.
  dayRate               Decimal @db.Decimal(12, 2)
  halfDayRate           Decimal @db.Decimal(12, 2)
  additionalDayRate     Decimal @db.Decimal(12, 2)
  additionalHalfDayRate Decimal @db.Decimal(12, 2)
  veridianPerWeek Decimal @db.Decimal(4, 2)
  detentPerWeek   Decimal @db.Decimal(4, 2)
  otherPerWeek    Decimal @db.Decimal(4, 2)
  leaveDays       Decimal @db.Decimal(5, 2)
  leaveYearStart  Int     @default(1) // month: 1 = January
  bankHolidayCountry String @default("GB") // gov.uk JSON for GB; Nager.Date for AU
  // Cancellation charge tiers (consultancy agreement schedule 1 s8.4), JSON
  // [{minNoticeDays, chargeFraction}]: under 14 days 100%, 14-44 75%,
  // 45-89 50%, 90+ free.
  cancellationTiersJson String @default("[{\"minNoticeDays\":90,\"chargeFraction\":0},{\"minNoticeDays\":45,\"chargeFraction\":0.5},{\"minNoticeDays\":14,\"chargeFraction\":0.75},{\"minNoticeDays\":0,\"chargeFraction\":1}]")
  amberThreshold  Decimal @db.Decimal(4, 3) @default(0.800)
  redThreshold    Decimal @db.Decimal(4, 3) @default(0.950)
  defaultWinProbability Decimal @db.Decimal(4, 3) @default(0.500)
  expenseMarkup   Decimal @db.Decimal(5, 4) @default(0)
  statementWorkingDay Int @default(3) // statements on the Nth working day
  fridayConfirmReminder Boolean @default(true)
  createdAt       DateTime @default(now())

  @@unique([userId, effectiveFrom])
}

// ---------- Entities, clients, contracts ----------

model Entity {
  id          String  @id @default(cuid())
  name        String // Veridian Revenue Partners Limited, ...
  companyNumber String?
  addressLines String?
  currency    String  @default("GBP")
  vatRegistered Boolean @default(false)
  vatNumber   String?
  createdAt   DateTime @default(now())

  shares    EntityShare[]
  clients   Client[]
  templates Template[]
}

model EntityShare {
  id       String @id @default(cuid())
  entityId String
  entity   Entity @relation(fields: [entityId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead   Boolean @default(false) // shared-client overage is always billed by Veridian Revenue Partners Limited

  @@unique([entityId, userId])
}

model Template {
  id        String   @id @default(cuid())
  entityId  String
  entity    Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)
  name      String
  kind      String // contract, sow
  fileKey   String // object storage key for the .docx with {{merge}} fields
  createdAt DateTime @default(now())

  contracts ContractDocument[]
}

enum ClientStatus {
  SIGNED
  PENCILLED
  ENDED
}

model Client {
  id        String       @id @default(cuid())
  entityId  String
  entity    Entity       @relation(fields: [entityId], references: [id], onDelete: Restrict)
  name      String // reserved allocation names rejected in code
  status    ClientStatus @default(PENCILLED)
  winProbability Decimal? @db.Decimal(4, 3)
  mondayItemId   String? // stage mapping supplies a probability when set
  contactName  String?
  contactEmail String?
  createdAt DateTime @default(now())
  archivedAt DateTime?

  shares        ClientShare[]
  terms         ContractTerm[]
  bookings      Booking[]
  expenses      Expense[]
  statements    Statement[]
  contracts     ContractDocument[]
  scenarioLinks ScenarioClient[]

  @@unique([entityId, name])
}

model ClientShare {
  id       String @id @default(cuid())
  clientId String
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  isLead   Boolean @default(false)

  @@unique([clientId, userId])
}

model ContractTerm {
  id            String   @id @default(cuid())
  clientId      String
  client        Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  frequency     String // '1 day a week' ... 'Half day a month'
  contractStart DateTime @db.Date
  termMonths    Int      @default(12)
  noticeDays    Int      @default(90)
  noticeGivenOn DateTime? @db.Date
  lateNoticeOverride Boolean @default(false) // admin let a late notice end the term (logged)
  // Signed rates, frozen at signature (settings changes do not touch them).
  currency              String  @default("GBP")
  dayRate               Decimal @db.Decimal(12, 2)
  halfDayRate           Decimal @db.Decimal(12, 2)
  additionalDayRate     Decimal @db.Decimal(12, 2)
  additionalHalfDayRate Decimal @db.Decimal(12, 2)
  createdAt     DateTime @default(now())
  endedAt       DateTime?
}

// ---------- Bookings and the calendar ----------

enum BookingKind {
  CLIENT
  LEAVE
  DETENT
  ADMIN_BD
  OTHER
}

enum DeliveryState {
  PLANNED
  UNCONFIRMED
  DELIVERED
  CANCELLED_IN_TIME
  CANCELLED_LATE
  CANCELLED_BY_CONSULTANT
  MOVED
}

enum HalfDaySlot {
  AM
  PM
}

model Booking {
  id        String      @id @default(cuid())
  userId    String // a booking belongs to one user and one date
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  date      DateTime    @db.Date
  slot      HalfDaySlot? // null = full day; half days take AM or PM, max two per date
  kind      BookingKind
  clientId  String?
  client    Client?     @relation(fields: [clientId], references: [id], onDelete: Restrict)
  notes     String?
  deliveryState DeliveryState @default(PLANNED)
  deliveryNote  String?
  deliveredConfirmedAt DateTime?
  cancelledById String?
  cancelledAt   DateTime?
  // Charge fraction applied when a cancellation is chargeable, from the
  // cancellation tiers in force when it was cancelled.
  cancellationChargeFraction Decimal? @db.Decimal(4, 3)
  movedToBookingId String? @unique
  movedTo          Booking? @relation("BookingMove", fields: [movedToBookingId], references: [id])
  movedFrom        Booking? @relation("BookingMove")
  // A13: edits after the statement was sent are allowed, flagged and logged.
  editedAfterStatement Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, date])
  @@index([clientId, date])
}

model CalendarSource {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String // each user can have two published ICS links
  urlEncrypted String // encrypted at rest
  lastPolledAt DateTime?
  lastOkAt     DateTime?
  lastError    String? // A17: one feed failing must not break the other
  createdAt DateTime @default(now())

  events CalendarEvent[]
}

model CalendarEvent {
  id        String   @id @default(cuid())
  sourceId  String
  source    CalendarSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  uid       String // iCalendar UID (recurrence-expanded occurrences get uid+date)
  startsAt  DateTime
  endsAt    DateTime
  allDay    Boolean  @default(false)
  busy      Boolean  @default(true) // transparency; tentative handled in code (A15)
  tentative Boolean  @default(false)
  summaryRedacted String? // free/busy only for other partners
  fetchedAt DateTime @default(now())

  @@unique([sourceId, uid, startsAt])
  @@index([sourceId, startsAt])
}

model BankHoliday {
  id      String   @id @default(cuid())
  country String // GB, AU
  date    DateTime @db.Date
  name    String

  @@unique([country, date])
}

model FxRate {
  id    String   @id @default(cuid())
  date  DateTime @db.Date
  base  String // GBP
  quote String // AUD, ...
  rate  Decimal  @db.Decimal(18, 8)

  @@unique([date, base, quote])
}

model MondayConnection {
  id            String   @id @default(cuid())
  tokenEncrypted String
  boardId       String?
  stageColumnId String?
  stageMappingJson String // stage -> win probability
  lastSyncAt    DateTime?
  createdAt     DateTime @default(now())
}

// ---------- Expenses ----------

model Expense {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  clientId  String?
  client    Client?  @relation(fields: [clientId], references: [id], onDelete: SetNull)
  date      DateTime @db.Date
  category  String // Travel, Mileage, Accommodation, Subsistence, Other
  description String?
  miles     Decimal? @db.Decimal(8, 1)
  amountExVat Decimal? @db.Decimal(12, 2)
  vatAmount   Decimal? @db.Decimal(12, 2) // per entity VAT registration rules
  currency  String   @default("GBP")
  fxRate    Decimal? @db.Decimal(18, 8) // day rate for foreign spend
  netCost   Decimal  @db.Decimal(12, 2)
  rechargeable Boolean @default(false)
  rechargeAmount Decimal @db.Decimal(12, 2) @default(0)
  billedAt  DateTime? // locked once exported
  createdAt DateTime @default(now())

  receipts ExpenseReceipt[]

  @@index([clientId, date])
}

model ExpenseReceipt {
  id        String  @id @default(cuid())
  expenseId String
  expense   Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  fileKey   String // object storage
  uploadedAt DateTime @default(now())
}

model MileageLedger {
  id      String   @id @default(cuid())
  userId  String
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  taxYearStart DateTime @db.Date // 6 April
  date    DateTime @db.Date
  miles   Decimal  @db.Decimal(8, 1)
  cumulativeMilesAfter Decimal @db.Decimal(10, 1)

  @@index([userId, taxYearStart])
}

// ---------- Scenarios ----------

model Scenario {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name      String
  includePencilled Boolean @default(true)
  veridianPerWeek  Decimal @db.Decimal(4, 2)
  dayRate          Decimal @db.Decimal(12, 2)
  halfDayRate      Decimal @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  clients ScenarioClient[]
}

model ScenarioClient {
  id         String   @id @default(cuid())
  scenarioId String
  scenario   Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  name       String
  frequency  String
  startDate  DateTime? @db.Date // A22: start dates can create overbooked weeks
  madePencilledClientId String? // set when "Make pencilled" copied it to real data
  client     Client?  @relation(fields: [madePencilledClientId], references: [id], onDelete: SetNull)
}

// ---------- Statements, contracts, billing ----------

model Statement {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  monthStart DateTime @db.Date
  version   Int      @default(1) // A13: edits after send offer version 2
  pdfFileKey String?
  sentAt    DateTime? // locked once sent
  sentTo    String?
  createdAt DateTime @default(now())

  lines StatementLine[]

  @@unique([clientId, monthStart, version])
}

model StatementLine {
  id          String    @id @default(cuid())
  statementId String
  statement   Statement @relation(fields: [statementId], references: [id], onDelete: Cascade)
  date        DateTime? @db.Date
  label       String
  halfDay     Boolean   @default(false)
  status      String?
  amount      Decimal?  @db.Decimal(12, 2)
  sortOrder   Int
}

model ContractDocument {
  id         String   @id @default(cuid())
  clientId   String
  client     Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId String
  template   Template @relation(fields: [templateId], references: [id], onDelete: Restrict)
  version    Int      @default(1)
  mergeDataJson String // the {{field}} values used
  docxFileKey String
  pdfFileKey  String?
  createdAt  DateTime @default(now())

  @@unique([clientId, templateId, version])
}

model BillingSummary {
  id         String   @id @default(cuid())
  monthStart DateTime @db.Date
  entityId   String
  csvFileKey String? // Xero CSV: *ContactName, EmailAddress, *InvoiceNumber, ...
  exportedAt DateTime? // lines locked once exported
  createdAt  DateTime @default(now())

  @@unique([monthStart, entityId])
}

// ---------- Alerts and audit ----------

model Alert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String // over_allowance, confirm_past_days, nearly_used, unused_at_risk, notice_soon, receipt_missing, feed_failed, new_device, ...
  clientId  String?
  payloadJson String?
  emailedAt DateTime? // the new-device alert cannot be switched off
  readAt    DateTime?
  createdAt DateTime @default(now())

  @@index([userId, readAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  entityType String?
  entityId  String?
  detailJson String?
  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}
